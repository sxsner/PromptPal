<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Name="RootPage"
    x:Class="PromptPal_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PromptPal_App"
    xmlns:prim="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource AppBg}"
    FontFamily="{ThemeResource ContentControlThemeFontFamily}"
    FontSize="13">

    <Page.Resources>
        <!-- 扁平按钮：自绘 Border，配色全部走主题资源 -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"/>
                            <Border x:Name="Hover" Background="{ThemeResource OverlayHover}"
                                    CornerRadius="{TemplateBinding CornerRadius}" Opacity="0"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="Hover"
                                        Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08"/></Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="Hover"
                                        Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0"/></Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="Hover"
                                        Storyboard.TargetProperty="Opacity" To="0" Duration="0"/></Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 图标按钮 -->
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{ThemeResource TextSecondary}"/>
        </Style>

        <!-- 分类胶囊：横向滚动、自动宽度 -->
        <Style x:Key="CategoryPill" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="{ThemeResource ChipBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="NewAccel_Invoked"/>
        <KeyboardAccelerator Key="Delete" Invoked="DeleteAccel_Invoked"/>
        <KeyboardAccelerator Key="Escape" Invoked="EscapeAccel_Invoked"/>
    </Page.KeyboardAccelerators>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ 主区域：两栏 ============ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="200" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- ============ 左栏 ============ -->
            <Grid Grid.Column="0" Background="{ThemeResource RailBg}" BorderBrush="{ThemeResource BorderL1}"
                  BorderThickness="0,0,1,0" Padding="6" RowSpacing="6" RightTapped="Rail_RightTapped">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 筛选 + 新建 -->
                    <RowDefinition Height="Auto"/> <!-- 分类胶囊 -->
                    <RowDefinition Height="Auto"/> <!-- 排序 -->
                    <RowDefinition Height="*"/>     <!-- 提示词列表 -->
                </Grid.RowDefinitions>

                <!-- 筛选 chips + 新建（右键：筛选/新建/刷新） -->
                <Grid Grid.Row="0" RightTapped="FilterRow_RightTapped">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                        <Button Style="{StaticResource FlatButton}" Height="26" Padding="9,0" FontSize="12"
                                HorizontalContentAlignment="Center"
                                BorderBrush="{ThemeResource ChipBorder}" BorderThickness="1"
                                Background="{x:Bind VM.IsAllSelected, Mode=OneWay, Converter={StaticResource ChipBackgroundConverter}}"
                                Foreground="{x:Bind VM.IsAllSelected, Mode=OneWay, Converter={StaticResource ChipForegroundConverter}}"
                                Click="CategoryButton_Click" Tag="__all__" Content="全部"/>
                        <Button Style="{StaticResource FlatButton}" Height="26" Padding="9,0" FontSize="12"
                                HorizontalContentAlignment="Center"
                                BorderBrush="{ThemeResource ChipBorder}" BorderThickness="1"
                                Background="{x:Bind VM.ShowFavoritesOnly, Mode=OneWay, Converter={StaticResource ChipBackgroundConverter}}"
                                Foreground="{x:Bind VM.ShowFavoritesOnly, Mode=OneWay, Converter={StaticResource ChipForegroundConverter}}"
                                Click="FavoritesButton_Click" Content="收藏"/>
                        <Button Style="{StaticResource FlatButton}" Height="26" Padding="9,0" FontSize="12"
                                HorizontalContentAlignment="Center"
                                BorderBrush="{ThemeResource ChipBorder}" BorderThickness="1"
                                Background="{x:Bind VM.ShowRecentOnly, Mode=OneWay, Converter={StaticResource ChipBackgroundConverter}}"
                                Foreground="{x:Bind VM.ShowRecentOnly, Mode=OneWay, Converter={StaticResource ChipForegroundConverter}}"
                                Click="RecentButton_Click" Content="最近"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource FlatButton}" Width="26" Height="26" Padding="0"
                            Background="{ThemeResource Accent}" Foreground="{ThemeResource AccentOnText}"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Click="NewPrompt_Click" ToolTipService.ToolTip="新建提示词"
                            AutomationProperties.Name="新建提示词">
                        <FontIcon Glyph="&#xE710;" FontSize="15"/>
                    </Button>
                </Grid>

                <!-- 分类：横向滚动胶囊 -->
                <ScrollViewer Grid.Row="1" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource CategoryPill}"
                                        Background="{Binding IsSelected, Converter={StaticResource SelectedOverlayConverter}}"
                                        Foreground="{Binding IsSelected, Converter={StaticResource NavForegroundConverter}}"
                                        Click="CategoryButton_Click" Tag="{Binding Category}"
                                        RightTapped="CategoryPill_RightTapped"
                                        Content="{Binding Category.Name}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 排序（右键：切换排序方式） -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4" RightTapped="SortRow_RightTapped">
                    <TextBlock Text="排序" FontSize="11" Foreground="{ThemeResource TextTertiary}" VerticalAlignment="Center" Margin="2,0,2,0"/>
                    <Button Style="{StaticResource FlatButton}" Height="22" Padding="7,0" FontSize="11"
                            Command="{Binding SetSortCommand}" CommandParameter="frequency"
                            Background="{Binding IsSortFrequency, Converter={StaticResource SelectedOverlayConverter}}"
                            Foreground="{Binding IsSortFrequency, Converter={StaticResource NavForegroundConverter}, ConverterParameter=sort}" Content="频率"/>
                    <Button Style="{StaticResource FlatButton}" Height="22" Padding="7,0" FontSize="11"
                            Command="{Binding SetSortCommand}" CommandParameter="updated"
                            Background="{Binding IsSortUpdated, Converter={StaticResource SelectedOverlayConverter}}"
                            Foreground="{Binding IsSortUpdated, Converter={StaticResource NavForegroundConverter}, ConverterParameter=sort}" Content="更新"/>
                    <Button Style="{StaticResource FlatButton}" Height="22" Padding="7,0" FontSize="11"
                            Command="{Binding SetSortCommand}" CommandParameter="name"
                            Background="{Binding IsSortName, Converter={StaticResource SelectedOverlayConverter}}"
                            Foreground="{Binding IsSortName, Converter={StaticResource NavForegroundConverter}, ConverterParameter=sort}" Content="名称"/>
                </StackPanel>

                <!-- 提示词列表（空白区右键：新建/粘贴新建/刷新；条目自身有独立菜单） -->
                <Grid Grid.Row="3">
                    <ListView ItemsSource="{Binding Prompts}"
                              SelectedItem="{Binding SelectedPrompt, Mode=TwoWay}"
                              SelectionMode="Single" Background="Transparent" BorderThickness="0"
                              RightTapped="ListArea_RightTapped"
                              Padding="0">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="MinHeight" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <ListViewItemPresenter ContentMargin="8,7,8,7" CornerRadius="0"
                                                CheckBoxBrush="Transparent"
                                                Background="Transparent"
                                                PointerOverBackground="{ThemeResource OverlayHover}"
                                                PressedBackground="{ThemeResource OverlayHover}"
                                                SelectedBackground="{ThemeResource SelectionBg}"
                                                SelectedPointerOverBackground="{ThemeResource SelectionBg}"
                                                SelectedPressedBackground="{ThemeResource SelectionBg}"
                                                BorderBrush="{ThemeResource BorderL1}" BorderThickness="0"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="3" RightTapped="PromptItem_RightTapped" DoubleTapped="PromptItem_DoubleTapped">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                            <!-- 固定 14px 收藏列：始终占位，仅图标淡入淡出，标题文字不发生位移 -->
                                            <Grid Width="14" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE735;" FontSize="12"
                                                          Foreground="{ThemeResource Accent}"
                                                          Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisConverter}}"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Title}" FontSize="{Binding DataContext.ListTitleFont, ElementName=RootPage}" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextDefault}"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding UseCount}" FontSize="{Binding DataContext.ListBodyFont, ElementName=RootPage}"
                                                   Visibility="{Binding DataContext.ShowUseCount, ElementName=RootPage, Converter={StaticResource BoolToVisConverter}}"
                                                   Foreground="{ThemeResource TextTertiary}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="{Binding ContentPreview}" FontSize="{Binding DataContext.ListBodyFont, ElementName=RootPage}"
                                               Foreground="{ThemeResource TextTertiary}"
                                               TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Text="暂无提示词，点 ＋ 新建第一条" TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"
                               Foreground="{ThemeResource TextTertiary}" IsHitTestVisible="False"
                               Visibility="{Binding HasPrompts, Converter={StaticResource InvertBoolToVisConverter}}"/>
                </Grid>
            </Grid>

            <!-- ============ 右栏 ============ -->
            <Grid Grid.Column="1" RightTapped="Detail_RightTapped">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题 + 操作 -->
                <Grid Grid.Row="0" Padding="16,12,12,12" BorderBrush="{ThemeResource BorderL1}" BorderThickness="0,0,0,1"
                      Visibility="{x:Bind VM.SelectedPrompt, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedPrompt.Title}" FontWeight="SemiBold"
                                   FontSize="{Binding DetailTitleFont}"
                                   Foreground="{ThemeResource TextDefault}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock FontSize="12" Foreground="{ThemeResource TextTertiary}"
                                       Visibility="{Binding ShowUseCount, Converter={StaticResource BoolToVisConverter}}">
                                <Run Text="{Binding SelectedPrompt.UseCount}"/><Run Text=" 次"/>
                            </TextBlock>
                            <Ellipse Width="3" Height="3" Fill="{ThemeResource TextTertiary}" VerticalAlignment="Center"
                                     Visibility="{Binding SelectedPrompt.Category, Converter={StaticResource ObjectToVisibilityConverter}}"/>
                            <TextBlock Text="{Binding SelectedPrompt.Category.Name}" FontSize="12"
                                       Foreground="{ThemeResource TextTertiary}" VerticalAlignment="Center"
                                       Visibility="{Binding SelectedPrompt.Category, Converter={StaticResource ObjectToVisibilityConverter}}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Command="{Binding ToggleFavoriteCommand}"
                                ToolTipService.ToolTip="收藏/取消" AutomationProperties.Name="收藏">
                            <!-- 未收藏=灰色描边星，已收藏=强调色实心星，切换即同步点亮 -->
                            <Grid Width="18" Height="18">
                                <FontIcon Glyph="&#xE734;" FontSize="16"
                                          Foreground="{ThemeResource TextSecondary}"
                                          Visibility="{Binding SelectedPrompt.IsFavorite, Converter={StaticResource InvertBoolToVisConverter}}"/>
                                <FontIcon Glyph="&#xE735;" FontSize="16"
                                          Foreground="{ThemeResource Accent}"
                                          Visibility="{Binding SelectedPrompt.IsFavorite, Converter={StaticResource BoolToVisConverter}}"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Click="EditPrompt_Click"
                                ToolTipService.ToolTip="编辑" AutomationProperties.Name="编辑">
                            <FontIcon Glyph="&#xE70F;" FontSize="16"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Click="DeletePrompt_Click"
                                ToolTipService.ToolTip="删除" AutomationProperties.Name="删除">
                            <FontIcon Glyph="&#xE74D;" FontSize="16"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 正文（最大化显示） -->
                <ScrollViewer Grid.Row="1" Padding="16,14,16,12"
                              Visibility="{x:Bind VM.SelectedPrompt, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}}">
                    <TextBlock Text="{Binding SelectedPrompt.Content}" TextWrapping="Wrap"
                               FontSize="{Binding BodyFont}" LineHeight="26" IsTextSelectionEnabled="True"
                               Foreground="{ThemeResource TextDefault}"/>
                </ScrollViewer>

                <!-- 复制 -->
                <Border Grid.Row="2" Background="{ThemeResource RailBg}" BorderBrush="{ThemeResource BorderL1}"
                        BorderThickness="0,1,0,0" Padding="12,8"
                        Visibility="{x:Bind VM.SelectedPrompt, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}}">
                    <Button Style="{StaticResource FlatButton}" Height="34" AutomationProperties.Name="复制提示词"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Background="{ThemeResource Accent}" Foreground="{ThemeResource AccentOnText}" FontSize="14"
                            Command="{Binding CopyCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8C8;" FontSize="15"/>
                            <TextBlock Text="复制提示词"/>
                        </StackPanel>
                    </Button>
                </Border>

                <!-- 空态：未选中 -->
                <TextBlock Grid.Row="1" Text="← 从左侧选择一条提示词"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="14" Foreground="{ThemeResource TextTertiary}" IsHitTestVisible="False"
                           Visibility="{x:Bind VM.SelectedPrompt, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}, ConverterParameter=invert}"/>
            </Grid>
        </Grid>

        <!-- ============ 底部状态条（复制反馈也放这里，不再用 InfoBar 顶动布局） ============ -->
        <Grid Grid.Row="1" Height="28" Background="{ThemeResource RailBg}" BorderBrush="{ThemeResource BorderL1}"
              BorderThickness="0,1,0,0" Padding="10,0">
            <Grid.ColumnDefinitions>
                <!-- 右列 Auto：仅占内容宽度，窗口拉到最小（640）时置顶/设置按钮也不会被裁出可视区 -->
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Ellipse Width="6" Height="6" Fill="{ThemeResource Accent}" VerticalAlignment="Center"/>
                <TextBlock FontSize="12" Foreground="{ThemeResource TextTertiary}" VerticalAlignment="Center">
                    <Run Text="{Binding Prompts.Count}"/><Run Text=" 条提示词"/>
                </TextBlock>
            </StackPanel>
            <!-- 中央：瞬时反馈（已复制/失败），空串自动隐藏，状态栏高度固定不跳动；
                 成功/失败文字色由 StatusIsError 经转换器从当前主题资源取色 -->
            <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="12"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{Binding StatusIsError, Converter={StaticResource StatusBrushConverter}}"
                       Visibility="{Binding StatusText, Converter={StaticResource StringToVisConverter}}"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="PinButton" Style="{StaticResource IconButton}" Width="28" Height="26"
                        Click="PinToggle_Click"
                        ToolTipService.ToolTip="固定到最前" AutomationProperties.Name="固定到最前">
                    <FontIcon x:Name="PinGlyph" Glyph="&#xE840;" FontSize="15"/>
                </Button>
                <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Width="28" Height="26"
                        Click="Settings_Click"
                        ToolTipService.ToolTip="设置" AutomationProperties.Name="设置">
                    <FontIcon Glyph="&#xE713;" FontSize="15"/>
                </Button>
                <TextBlock Text="热键" FontSize="12" Foreground="{ThemeResource TextTertiary}" VerticalAlignment="Center"/>
                <Border Background="{ThemeResource OverlayHover}" Padding="6,2">
                    <TextBlock Text="Ctrl+Shift+P" FontSize="12"
                               Foreground="{ThemeResource TextSecondary}"/>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
