<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="PromptPal_App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PromptPal_App"
    xmlns:conv="using:PromptPal_App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <!-- Light 与 Default 同值：Default 作回退，Light 是系统浅色模式的正式键。
                     浅色下文字/线条取色偏保守（TextTertiary 不浅于 #5E5E5E、线条不浅于 #C4C4C4），
                     保证在 #F3F3F3 轨色上也达到 WCAG AA 对比、分割线清晰可见 -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBg" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="RailBg" Color="#FFF3F3F3"/>
                    <SolidColorBrush x:Key="CardBg" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="ChipBg" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="TextDefault" Color="#FF1A1A1A"/>
                    <SolidColorBrush x:Key="TextSecondary" Color="#FF404040"/>
                    <SolidColorBrush x:Key="TextTertiary" Color="#FF5E5E5E"/>
                    <SolidColorBrush x:Key="BorderL1" Color="#FFC4C4C4"/>
                    <SolidColorBrush x:Key="ChipBorder" Color="#FFB8B8B8"/>
                    <SolidColorBrush x:Key="OverlayHover" Color="#19000000"/>
                    <SolidColorBrush x:Key="SelectionBg" Color="#FFCCE4F7"/>
                    <SolidColorBrush x:Key="Accent" Color="{ThemeResource SystemAccentColor}"/>
                    <SolidColorBrush x:Key="DangerText" Color="#FFC42B1C"/>
                    <SolidColorBrush x:Key="SuccessText" Color="#FF107C10"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="AppBg" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="RailBg" Color="#FFF3F3F3"/>
                    <SolidColorBrush x:Key="CardBg" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="ChipBg" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="TextDefault" Color="#FF1A1A1A"/>
                    <SolidColorBrush x:Key="TextSecondary" Color="#FF404040"/>
                    <SolidColorBrush x:Key="TextTertiary" Color="#FF5E5E5E"/>
                    <SolidColorBrush x:Key="BorderL1" Color="#FFC4C4C4"/>
                    <SolidColorBrush x:Key="ChipBorder" Color="#FFB8B8B8"/>
                    <SolidColorBrush x:Key="OverlayHover" Color="#19000000"/>
                    <SolidColorBrush x:Key="SelectionBg" Color="#FFCCE4F7"/>
                    <SolidColorBrush x:Key="Accent" Color="{ThemeResource SystemAccentColor}"/>
                    <SolidColorBrush x:Key="DangerText" Color="#FFC42B1C"/>
                    <SolidColorBrush x:Key="SuccessText" Color="#FF107C10"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBg" Color="#FF202020"/>
                    <SolidColorBrush x:Key="RailBg" Color="#FF2B2B2B"/>
                    <SolidColorBrush x:Key="CardBg" Color="#FF333333"/>
                    <SolidColorBrush x:Key="ChipBg" Color="#FF383838"/>
                    <SolidColorBrush x:Key="TextDefault" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="TextSecondary" Color="#FFE0E0E0"/>
                    <SolidColorBrush x:Key="TextTertiary" Color="#FFA6A6A6"/>
                    <SolidColorBrush x:Key="BorderL1" Color="#FF3D3D3D"/>
                    <SolidColorBrush x:Key="ChipBorder" Color="#FF5A5A5A"/>
                    <SolidColorBrush x:Key="OverlayHover" Color="#19FFFFFF"/>
                    <SolidColorBrush x:Key="SelectionBg" Color="#FF3A4E5C"/>
                    <SolidColorBrush x:Key="Accent" Color="{ThemeResource SystemAccentColor}"/>
                    <SolidColorBrush x:Key="DangerText" Color="#FFFF99A4"/>
                    <SolidColorBrush x:Key="SuccessText" Color="#FF6CCB5F"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- 值转换器 -->
            <conv:BoolToVisConverter x:Key="BoolToVisConverter"/>
            <conv:InvertBoolToVisConverter x:Key="InvertBoolToVisConverter"/>
            <conv:StringToVisConverter x:Key="StringToVisConverter"/>
            <conv:StatusBrushConverter x:Key="StatusBrushConverter"/>
            <conv:SelectedNavBrushConverter x:Key="SelectedNavBrushConverter"/>
            <conv:ObjectToVisibilityConverter x:Key="ObjectToVisibilityConverter"/>
            <conv:ChipBackgroundConverter x:Key="ChipBackgroundConverter"/>
            <conv:ChipForegroundConverter x:Key="ChipForegroundConverter"/>
            <conv:SelectedOverlayConverter x:Key="SelectedOverlayConverter"/>
            <conv:NavForegroundConverter x:Key="NavForegroundConverter"/>

            <!-- 强调色按钮上的文字：非主题键，启动时按用户强调色亮度改写颜色（白/黑） -->
            <SolidColorBrush x:Key="AccentOnText" Color="#FFFFFFFF"/>

            <!-- 设置可运行时修改、XAML 用 {ThemeResource} 引用（实际刷新走 VM 的 INPC 绑定） -->
            <x:Double x:Key="BodyFont">15</x:Double>
            <x:Double x:Key="ListTitleFont">14</x:Double>
            <x:Double x:Key="ListBodyFont">12</x:Double>
            <x:Double x:Key="DetailTitleFont">18</x:Double>
            <Visibility x:Key="UseCountVisibility">Visible</Visibility>
        </ResourceDictionary>
    </Application.Resources>
</Application>


