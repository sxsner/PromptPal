<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="PromptPal_App.PromptEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 标题 -->
            <RowDefinition Height="*"/>       <!-- 表单 -->
            <RowDefinition Height="Auto"/>    <!-- 底部按钮 -->
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Grid.Row="0" Text="新建提示词"
                   FontSize="18" FontWeight="SemiBold"
                   Foreground="{ThemeResource TextDefault}"/>

        <StackPanel Grid.Row="1" Spacing="12">
            <StackPanel Spacing="4">
                <TextBlock Text="标题" FontSize="13" Foreground="{ThemeResource TextSecondary}"/>
                <TextBox x:Name="TitleBox" PlaceholderText="例如：代码 Review 助手" MaxLength="256"/>
            </StackPanel>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="分类" FontSize="13" Foreground="{ThemeResource TextSecondary}"/>
                    <ComboBox x:Name="CategoryBox" PlaceholderText="未分类" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="标签" FontSize="13" Foreground="{ThemeResource TextSecondary}"/>
                    <TextBox x:Name="TagsBox" PlaceholderText="逗号分隔，如：代码, review"/>
                </StackPanel>
            </Grid>

            <StackPanel Spacing="4">
                <TextBlock Text="提示词内容" FontSize="13" Foreground="{ThemeResource TextSecondary}"/>
                <TextBox x:Name="ContentBox" AcceptsReturn="True" MinHeight="220"
                         TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         PlaceholderText="输入提示词内容，复制后可直接粘贴到任意对话……"/>
            </StackPanel>

            <TextBlock x:Name="ErrorText" Visibility="Collapsed" FontSize="13" TextWrapping="Wrap"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="CancelBtn" Content="取消" MinWidth="88" Height="34" Click="Cancel_Click"/>
            <Button x:Name="SaveBtn" Content="保存" MinWidth="88" Height="34"
                    Style="{ThemeResource AccentButtonStyle}" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
