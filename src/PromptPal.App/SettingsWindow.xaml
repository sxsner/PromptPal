<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="PromptPal_App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="设置 — PromptPal">

    <Grid x:Name="Root" Background="{ThemeResource AppBg}">
        <Grid.Resources>
            <Style x:Key="NavItem" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="0"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="Margin" Value="0,1"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{ThemeResource TextSecondary}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="Bg" Background="{TemplateBinding Background}"/>
                                <Border x:Name="Hover" Background="{ThemeResource OverlayHover}" Opacity="0"/>
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard><DoubleAnimation Storyboard.TargetName="Hover"
                                            Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08"/></Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard><DoubleAnimation Storyboard.TargetName="Hover"
                                            Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0"/></Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 侧栏 -->
        <StackPanel Grid.Column="0" Background="{ThemeResource RailBg}" BorderBrush="{ThemeResource BorderL1}"
                    BorderThickness="0,0,1,0" Padding="12,16">
            <TextBlock Text="PromptPal" FontSize="16" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextDefault}" Margin="8,0,8,12"/>
            <Button Style="{StaticResource NavItem}" Content="通用设置" Click="Nav_Click" Tag="SecAppearance"/>
            <Button Style="{StaticResource NavItem}" Content="热键设置" Click="Nav_Click" Tag="SecHotkey"/>
            <Button Style="{StaticResource NavItem}" Content="数据管理" Click="Nav_Click" Tag="SecData"/>
            <Button Style="{StaticResource NavItem}" Content="分类管理" Click="Nav_Click" Tag="SecCats"/>
            <Button Style="{StaticResource NavItem}" Content="MCP 接入" Click="Nav_Click" Tag="SecMcp"/>
            <Button Style="{StaticResource NavItem}" Content="关于" Click="Nav_Click" Tag="SecAbout"/>
        </StackPanel>

        <!-- 内容 -->
        <ScrollViewer x:Name="ContentScroll" Grid.Column="1" Padding="36,28,36,28" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="720" Spacing="0">
                <TextBlock Text="设置" FontSize="26" FontWeight="SemiBold" Foreground="{ThemeResource TextDefault}"/>
                <TextBlock Text="配置 PromptPal 的默认行为和外观，更改会自动保存并立即生效。"
                           FontSize="13" Foreground="{ThemeResource TextSecondary}" Margin="0,4,0,24"/>

                <!-- 外观 -->
                <StackPanel x:Name="SecAppearance" Spacing="14">
                    <TextBlock Text="外观" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource TextDefault}"/>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="主题" Foreground="{ThemeResource TextSecondary}"/>
                            <ComboBox x:Name="ThemeBox" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="跟随系统"/>
                                <ComboBoxItem Content="浅色"/>
                                <ComboBoxItem Content="深色"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="字体大小" Foreground="{ThemeResource TextSecondary}"/>
                            <ComboBox x:Name="FontBox" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="小"/>
                                <ComboBoxItem Content="默认"/>
                                <ComboBoxItem Content="大"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <Border Height="1" Background="{ThemeResource BorderL1}" Margin="0,24"/>

                <!-- 行为 -->
                <StackPanel Spacing="12">
                    <TextBlock Text="行为" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource TextDefault}"/>
                    <!-- ToggleSwitch 不赋值时会显示系统自带的“开/关”文字，靠近窗口底边还会被裁成残字；
                         Header 已表达含义，显式置空，用纯开关形态 -->
                    <ToggleSwitch x:Name="StartupHideToggle" Header="启动时最小化到托盘" OnContent="{x:Null}" OffContent="{x:Null}"/>
                    <ToggleSwitch x:Name="TrayCloseToggle" Header="关闭时最小化到托盘" OnContent="{x:Null}" OffContent="{x:Null}"/>
                    <ToggleSwitch x:Name="AutoHideCopyToggle" Header="复制后自动隐藏到托盘" OnContent="{x:Null}" OffContent="{x:Null}"/>
                    <ToggleSwitch x:Name="ShowCountToggle" Header="显示使用次数" OnContent="{x:Null}" OffContent="{x:Null}"/>
                    <ToggleSwitch x:Name="HotkeyToggle" Header="全局热键唤起" OnContent="{x:Null}" OffContent="{x:Null}"/>
                    <ToggleSwitch x:Name="StartupRunToggle" Header="开机自动启动" OnContent="{x:Null}" OffContent="{x:Null}"/>
                </StackPanel>

                <Border Height="1" Background="{ThemeResource BorderL1}" Margin="0,24"/>

                <!-- 热键 -->
                <StackPanel x:Name="SecHotkey" Spacing="12">
                    <TextBlock Text="全局热键" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource TextDefault}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="唤起主窗口" Width="120" VerticalAlignment="Center" Foreground="{ThemeResource TextSecondary}"/>
                        <Border Background="{ThemeResource RailBg}" BorderBrush="{ThemeResource BorderL1}" BorderThickness="1" Padding="8,3">
                            <TextBlock Text="Ctrl + Shift + P" FontFamily="Consolas" Foreground="{ThemeResource TextDefault}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="自定义热键组合即将开放。" FontSize="12" Foreground="{ThemeResource TextTertiary}"/>
                </StackPanel>

                <Border Height="1" Background="{ThemeResource BorderL1}" Margin="0,24"/>

                <!-- 数据管理 -->
                <StackPanel x:Name="SecData" Spacing="12">
                    <TextBlock Text="数据管理" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource TextDefault}"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="导出 / 导入数据库（.db）" Foreground="{ThemeResource TextDefault}"/>
                            <TextBlock Text="导出的单个 .db 就是完整数据库，可直接拷到新设备同名目录使用；导入会用该文件整体替换当前数据（自动留 .bak 备份）。"
                                       FontSize="12" Foreground="{ThemeResource TextTertiary}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Name="ExportBtn" Content="导出 .db" Click="Export_Click"/>
                            <Button x:Name="ImportBtn" Content="导入 .db" Click="Import_Click"/>
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="重置数据" Foreground="{ThemeResource TextDefault}"/>
                            <TextBlock Text="清除所有提示词和分类，恢复到初始状态。此操作不可撤销。"
                                       FontSize="12" Foreground="{ThemeResource TextTertiary}"/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="ResetBtn" Content="重置所有数据" Click="Reset_Click"
                                Foreground="{ThemeResource DangerText}" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock x:Name="DataStatus" FontSize="12" Foreground="{ThemeResource TextTertiary}"/>
                </StackPanel>

                <Border Height="1" Background="{ThemeResource BorderL1}" Margin="0,24"/>

                <!-- 分类管理 -->
                <StackPanel x:Name="SecCats" Spacing="12">
                    <TextBlock Text="分类管理" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource TextDefault}"/>
                    <TextBlock Text="按住卡片拖动调整顺序（键盘可用 Alt+Shift+↑/↓）；删除分类只会把其下提示词变为「未分类」。"
                               FontSize="12" Foreground="{ThemeResource TextTertiary}" TextWrapping="Wrap"/>
                    <ListView x:Name="CatList" SelectionMode="None" BorderThickness="0" MaxHeight="280"
                              CanDragItems="True" CanReorderItems="True" AllowDrop="True"
                              DragItemsCompleted="CatList_DragItemsCompleted">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="MinWidth" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{ThemeResource RailBg}"
                                        BorderBrush="{ThemeResource BorderL1}"
                                        BorderThickness="1" CornerRadius="8" Padding="12,8">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                        <TextBlock Grid.Column="0" Text="⋮⋮" FontSize="13"
                                                   Foreground="{ThemeResource TextTertiary}"
                                                   VerticalAlignment="Center" IsHitTestVisible="False"
                                                   ToolTipService.ToolTip="按住拖动调整顺序"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource TextDefault}"/>
                                        <Button Grid.Column="2" Content="重命名" Click="RenameCategory_Click"
                                                Padding="10,3" VerticalAlignment="Center"/>
                                        <Button Grid.Column="3" Content="删除" Click="DeleteCategory_Click"
                                                Padding="10,3" VerticalAlignment="Center"
                                                Foreground="{ThemeResource DangerText}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox x:Name="NewCatBox" Grid.Column="0" PlaceholderText="新分类名称（回车添加）" MaxLength="64"/>
                        <Button x:Name="AddCatBtn" Grid.Column="1" Content="添加" Click="AddCategory_Click"/>
                    </Grid>
                    <TextBlock x:Name="CatStatus" FontSize="12" Foreground="{ThemeResource TextTertiary}"/>
                </StackPanel>

                <Border Height="1" Background="{ThemeResource BorderL1}" Margin="0,24"/>

                <!-- MCP 接入 -->
                <StackPanel x:Name="SecMcp" Spacing="12">
                    <TextBlock Text="MCP 接入" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource TextDefault}"/>
                    <TextBlock Text="PromptPal 内置 MCP stdio 服务，AI 助手（如 Trae）可通过它直接检索、取用和增删改你的提示词与分类。"
                               FontSize="12" Foreground="{ThemeResource TextTertiary}" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="8">
                        <!-- RowDefinitions 不能省：原实现只给 ColumnDefinitions，
                             Grid.Row=1 的行会全部叠到第 0 行造成文字重叠 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Sidecar 程序" Foreground="{ThemeResource TextSecondary}" VerticalAlignment="Top"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
                            <TextBlock x:Name="McpPathText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextDefault}"/>
                            <TextBlock x:Name="McpStatusText" FontSize="12"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="可用工具（13 个）" Foreground="{ThemeResource TextSecondary}" VerticalAlignment="Top"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondary}"
                                   Text="list_categories / list_tags / search_prompts / get_prompt / copy_prompt / create_prompt / update_prompt / toggle_favorite / delete_prompt / create_category / rename_category / move_category / delete_category"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="CopyMcpConfigBtn" Content="复制注册配置（mcp.json）" Click="CopyMcpConfig_Click"/>
                        <Button x:Name="OpenMcpFolderBtn" Content="打开所在目录" Click="OpenMcpFolder_Click"/>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextTertiary}" TextWrapping="Wrap"
                                   Text="Trae 中两种注册方式任选其一："/>
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextTertiary}" TextWrapping="Wrap"
                                   Text="1) 打开 MCP 面板 → 添加 → 选 stdio → 命令粘贴上方路径；"/>
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextTertiary}" TextWrapping="Wrap"
                                   Text="2) 把复制的配置保存为项目根目录 .trae\mcp.json。"/>
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextTertiary}" TextWrapping="Wrap"
                                   Text="之后重新加载窗口（Ctrl+Shift+P → Reload Window），首次按提示信任即可。"/>
                    </StackPanel>
                    <TextBlock x:Name="McpTip" FontSize="12" Foreground="{ThemeResource TextTertiary}"/>
                </StackPanel>

                <Border Height="1" Background="{ThemeResource BorderL1}" Margin="0,24"/>

                <!-- 关于 -->
                <StackPanel x:Name="SecAbout" Spacing="8">
                    <TextBlock Text="关于" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource TextDefault}"/>
                    <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="版本" Foreground="{ThemeResource TextSecondary}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="VersionText" Text="v1.0.0" Foreground="{ThemeResource TextDefault}"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="数据库位置" Foreground="{ThemeResource TextSecondary}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="%LOCALAPPDATA%\PromptPal\promptpal.db"
                                   FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextDefault}"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="日志位置" Foreground="{ThemeResource TextSecondary}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="LogPathText"
                                   FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextDefault}"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="数据目录" Foreground="{ThemeResource TextSecondary}"/>
                        <Button Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" Content="打开数据目录（数据库 / 配置 / logs 日志）"
                                Click="OpenDataFolder_Click"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
